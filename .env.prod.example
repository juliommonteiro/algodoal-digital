# Produção (compose.prod.yml). No servidor: cp .env.prod.example .env.prod e preencha.
# O .env.prod real nunca vai para o git (.gitignore). Passo a passo: docs/deploy-aws.md.

# Endereço público, montado a partir do Elastic IP: 54.123.45.67 -> 54-123-45-67.sslip.io
# Se o Let's Encrypt recusar o sslip.io, troque só isto por 54-123-45-67.nip.io.
# Para testar no seu computador: DOMAIN=localhost (o Caddy usa um certificado próprio).
# O CORS é montado daqui (https://DOMAIN): front e API ficam na mesma origem.
DOMAIN=

# Assina os tokens de acesso e de renovação (JWT). Pelo menos 32 caracteres; trocar derruba
# todas as sessões. Gere com: openssl rand -hex 32
SECRET_KEY=

# Banco. Só letras e números na senha, porque ela vai dentro da URL de conexão.
# Gere com: openssl rand -hex 24
POSTGRES_USER=algodoal
POSTGRES_DB=algodoal
POSTGRES_PASSWORD=

# Conta admin criada pelo ./scripts/demo.sh. Fica de fora do docs/demo.md, porque quem
# escaneia o QR code do banner não pode virar admin. Pelo menos 12 caracteres.
# Gere com: openssl rand -base64 18
ADMIN_EMAIL=admin.demo@example.com
ADMIN_PASSWORD=

# Tentativas por minuto e por IP. Numa apresentação, a plateia sai toda pelo mesmo IP (Wi-Fi do
# evento ou 4G da operadora). Por isso aqui é bem mais que os 5 e 3 do desenvolvimento.
LIMITE_LOGIN=30/minute
LIMITE_REGISTRO=20/minute

# /docs e /api/v1/openapi.json. Desligados em produção; true liga.
API_DOCS=false
