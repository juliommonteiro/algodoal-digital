# Copie para .env (cp .env.example .env). Nunca versione o .env.

# Origem da API. Em dev o Vite faz proxy de /api para localhost:8000, então pode ficar vazio.
VITE_API_URL=

# true  = usa o mock em src/lib/mock.ts (dados fictícios, atraso de 300ms, nenhuma rede).
# false = fala com a API real em VITE_API_URL.
# Padrão true enquanto os endpoints de auth e de locais (S5, issues #10 e #11) não existem.
# No mock, entre com qualquer e-mail do seed (ex.: ana.turista@example.com) e qualquer
# senha de 8+ caracteres.
VITE_USAR_MOCK=true
